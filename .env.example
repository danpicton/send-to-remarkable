APP_BASE_URL=https://reader.example.internal
# Optional JSON list of exact public origins. When set, replaces APP_BASE_URL.
# APP_ALLOWED_ORIGINS='["https://reader.example.internal","https://reader.other.internal"]'
# Default deny: proxy must strip client-supplied identity headers, authenticate,
# and set this header. Only the proxy may reach the service.
AUTH_MODE=proxy
AUTH_HEADER=X-Auth-Request-User
RMFAKECLOUD_URL=https://rmfakecloud.example.internal
RMFAKECLOUD_USERNAME=reader@example.com
RMFAKECLOUD_PASSWORD=replace-me
RMFAKECLOUD_VERIFY_TLS=true
# Prefer a private CA bundle over disabling verification:
# RMFAKECLOUD_CA_BUNDLE=/run/certs/ca.pem
FETCH_TIMEOUT=20
CONVERSION_TIMEOUT=40
RMFAKECLOUD_TIMEOUT=20
MAX_PAGE_BYTES=4194304
MAX_DOCUMENT_BYTES=20971520
MAX_ARTICLE_CHARS=200000
MAX_CONVERSIONS=2
WORKER_MEMORY_MB=768
TEMP_DIR=/tmp/send-to-remarkable
